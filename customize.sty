% alterando a capa
\renewcommand{\imprimircapa}{%
  \begin{capa}%
    \center
    \ABNTEXchapterfont{
        MEC-SETEC\\
        INSTITUTO FEDERAL MINAS GERAIS - \textit{Campus} Formiga\\
        Curso de Ciência da Computação
    }

    \vspace*{1cm}

    \vfill
    \begin{center}
    \ABNTEXchapterfont\bfseries\large\MakeUppercase\imprimirtitulo
    \end{center}
    \vfill
    
    \abntex@ifnotempty{\imprimirautor}{%
        \hspace{.45\textwidth}
        \begin{minipage}{.5\textwidth}
        \SingleSpacing
        \ABNTEXchapterfont\imprimirautor
        \vfill
        \vspace*{1cm}
        {\imprimirorientadorRotulo~\imprimirorientador\par}
        \end{minipage}%
        \vspace*{\fill}
    }%
    
    \vspace*{1cm}
    
    {\imprimirlocal}
    \par
    {\imprimirdata}
  \end{capa}
}

